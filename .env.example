# ---- BOOTH 商品ページ 第三者レビュー: 環境設定 ----
# .env は秘密情報を含むため git に入れない (.gitignore 済)。
# 管理者用トークン・pepper は十分に長いランダム文字列を生成すること。
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- サーバー ---
NODE_ENV=production
# ホスト側に露出する API ポート (127.0.0.1 にのみ bind される)。
# コンテナ内部は固定 8080。宿の 8080 が他サービス (例 MagicMirror) で使用中なら 18080 などに変更。
API_PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=booth_review
# RC: 十分に長いランダム文字列に書き換えること
POSTGRES_PASSWORD=change-me-for-postgres
POSTGRES_DB=booth_review

# --- セキュリティ ---
# 匿名IDハッシュ化用の秘密値 (pepper)。変更すると既存の author_hash との対応が失われるので平時は絶対に変えない
PEPPER=change-me-random-32-bytes-hex
# 管理APIの Bearer トークン
ADMIN_TOKEN=change-me-random-32-bytes-hex
# CORSで許可するオリジン (カンマ区切り)。拡張機能のみの運用では空でよい
CORS_ORIGINS=
# CF-Connecting-IP を信頼するリクエスト元 (docker 内部ネットワーク)
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- レビューの制約 ---
MIN_BODY_LEN=10
MAX_BODY_LEN=2000
# 一定数以上の通報で自動非表示になる閾値
REPORT_AUTOHIDE_THRESHOLD=5

# --- レート制限 ---
RATE_LIMIT_POST_PER_IP_PER_HOUR=10
RATE_LIMIT_POST_PER_ANON_PER_HOUR=5
RATE_LIMIT_REPORT_PER_IP_PER_HOUR=20
RATE_LIMIT_REPORT_PER_ANON_PER_HOUR=10
RATE_LIMIT_LIST_PER_IP_PER_MINUTE=120
RATE_LIMIT_MINE_PER_IP_PER_MINUTE=30

# --- ページング / キャッシュ ---
PER_PAGE_DEFAULT=10
PER_PAGE_MAX=50
CACHE_MAX_AGE_SECONDS=60

# --- Cloudflare Tunnel ---
# Cloudflare ダッシュボードで Zero Trust > Networks > Tunnels から発行したトークン
TUNNEL_TOKEN=

# --- バックアップ ---
# 日次ダンプを行う時刻 (HH:MM, サーバー時刻)
BACKUP_TIME=03:30
# 保存しておく日数
BACKUP_KEEP_DAYS=30
# 保存先 (別ディスクのパスを推奨。例: /mnt/backup/boothreview)
BACKUP_DIR=./backups
